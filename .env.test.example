# Konfiguracja testów integracyjnych (vitest.integration.config.ts).
# Skopiuj ten plik do `.env.test.local` (gitignored) i uzupełnij wartościami
# z `npx supabase status` (lokalny stack Supabase musi działać):
#
#   cp .env.test.example .env.test.local
#
# SUPABASE_TEST_URL      = Project URL (API_URL), zwykle http://127.0.0.1:54321
# SUPABASE_TEST_ANON_KEY = ANON_KEY (klucz publiczny lokalnego stacku)
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_ANON_KEY=
