---
// Strona startowa TaskerLight (dla niezalogowanych — zalogowany jest przekierowywany do Skrzynki
// wejściowej w index.astro). Wariant „techniczny": tokeny motywu (jasny/ciemny), typografia IBM Plex,
// bez „cosmic"/starfield/gradientów odziedziczonych po starterze. Landing jest POZA powłoką (bez sidebara)
// — używa `Layout`, nie `AppLayout`, i ma własny, minimalny pasek nawigacji (marka + Zaloguj/Zarejestruj).
// Chipy typów odwzorowują język makiety (te same tokeny per typ co reszta aplikacji).
import Icon from "@/components/shell/Icon.astro";
import { ThemeToggle } from "@/components/ThemeToggle";
import { parseTheme, THEME_COOKIE } from "@/lib/theme";

// Motyw rozwiązany serwerowo (jak w AppLayout/Topbar) → wyspa przełącznika dostaje poprawny stan
// początkowy propem, bez odwróconego aria-label do czasu hydracji.
const theme = parseTheme(Astro.cookies.get(THEME_COOKIE)?.value);

// Typy wpisów jako wizualny motyw produktu — te same nazwy (labels.ts) i tokeny per typ co lista wpisów.
const TYPE_CHIPS = [
  { label: "Zadanie", cls: "bg-task-bg text-task-fg" },
  { label: "Notatka", cls: "bg-note-bg text-note-fg" },
  { label: "Pomysł", cls: "bg-idea-bg text-idea-fg" },
  { label: "Decyzja", cls: "bg-decision-bg text-decision-fg" },
  { label: "Inne", cls: "bg-other-bg text-other-fg" },
];

const primaryBtn =
  "inline-flex items-center justify-center rounded-[6px] bg-primary px-6 py-3 text-base font-medium text-primary-foreground transition-opacity hover:opacity-90";
const outlineBtn =
  "border-border text-foreground hover:bg-accent hover:text-accent-foreground inline-flex items-center justify-center rounded-[6px] border px-6 py-3 text-base font-medium transition-colors";
---

<div class="bg-background text-foreground flex min-h-screen flex-col">
  <header class="border-border flex items-center justify-between border-b px-6 py-4">
    <a href="/" class="flex items-center gap-2.5" aria-label="TaskerLight — strona główna">
      <span
        class="bg-primary text-primary-foreground flex size-[26px] shrink-0 items-center justify-center rounded-[4px]"
      >
        <Icon icon="layers" size={15} />
      </span>
      <span class="text-[15px] font-semibold tracking-tight">TaskerLight</span>
    </a>
    <nav class="flex items-center gap-2">
      <a
        href="/auth/signin"
        class="text-muted-foreground hover:text-foreground rounded-[5px] px-3 py-2 text-sm font-medium transition-colors"
      >
        Zaloguj się
      </a>
      <a
        href="/auth/signup"
        class="border-border text-foreground hover:bg-accent hover:text-accent-foreground rounded-[5px] border px-3.5 py-2 text-sm font-medium transition-colors"
      >
        Zarejestruj się
      </a>
      <ThemeToggle client:load initialTheme={theme} />
    </nav>
  </header>

  <main class="flex flex-1 flex-col items-center justify-center px-4 py-20 text-center sm:py-28">
    <div class="mb-7 flex flex-wrap items-center justify-center gap-1.5">
      {
        TYPE_CHIPS.map((t) => (
          <span class:list={`${t.cls} rounded-[3px] px-2 py-0.5 text-[10px] font-semibold tracking-[0.06em] uppercase`}>
            {t.label}
          </span>
        ))
      }
    </div>

    <h1 class="text-foreground mb-5 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
      TaskerLight
    </h1>
    <p class="text-muted-foreground mb-9 max-w-2xl text-lg leading-relaxed">
      Wrzucasz surowy strumień myśli — odbierasz uporządkowane wpisy: zadania, notatki, pomysły i decyzje. Klasyfikacją
      zajmuje się AI, decyzja zawsze należy do Ciebie.
    </p>

    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/auth/signin" class:list={primaryBtn}>Zaloguj się</a>
      <a href="/auth/signup" class:list={outlineBtn}>Zarejestruj się</a>
    </div>
  </main>
</div>
