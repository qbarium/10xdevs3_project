---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;

// Warianty na semantycznych tokenach (świadome motywu, zero zaszytego hex — Faza 8):
//   info    → rodzina niebieska „task" (jedyna niebieska rodzina tokenów; sygnał „informacja"),
//   warning → token ostrzegawczy `--warning-fg` (bursztyn),
//   error   → `--destructive` (czerwień shadcn).
// Tło jako półprzezroczysty odcień koloru wariantu, by czytelnie leżeć na tle w obu motywach.
const VARIANT_CLASSES: Record<Variant, string> = {
  info: "border-task-line bg-task-bg text-task-fg",
  warning: "border-warning-fg/60 bg-warning-fg/10 text-warning-fg",
  error: "border-destructive/60 bg-destructive/10 text-destructive",
};
---

<div
  class:list={[
    "border-b px-4 py-3 text-center text-sm [&_a]:font-semibold [&_a]:text-current [&_a]:underline",
    VARIANT_CLASSES[variant],
  ]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
