---
// Karta powitalna BYOK (US-06; zastępuje MissingKeyBanner — decyzja użytkownika 2026-07-02): PIERWSZY
// ekran każdego świeżego użytkownika (rejestracja → /ingest bez klucza), więc zamiast ostrzegawczego
// paska — wyśrodkowana, zachęcająca karta (tokeny motywu, oba warianty; rodzeństwo prymitywu Card ze
// Skrzynki): co to jest BYOK, jak chronimy klucz (szyfrowanie F-01), jaki model obsługujemy (żywa
// wartość z konfiguracji, nie hardcode) i dwie akcje. Render warunkowy należy do strony wołającej
// (Skrzynka wejściowa pokazuje kartę tylko gdy `!configured`).

interface Props {
  keysUrl: string;
  providerName: string;
  /** Aktualnie skonfigurowany model klasyfikatora (CLASSIFIER_MODEL z astro:env/server). */
  model: string;
}

const { keysUrl, providerName, model } = Astro.props;
---

<!-- Zwarte odstępy (p-6, gap-3, leading-snug): karta + nagłówek strony mieszczą się na laptopie
     bez pionowego scrolla (ta sama zasada co formularz wsadu — decyzja użytkownika 2026-07-02). -->
<section class="mx-auto w-full max-w-2xl">
  <div class="bg-card text-card-foreground rounded-xl border p-6 text-center shadow-sm sm:p-8">
    <div class="bg-muted border-border mx-auto mb-4 flex size-12 items-center justify-center rounded-full border">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-foreground"
      >
        <path
          d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"
        ></path>
        <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
      </svg>
    </div>

    <h2 class="text-foreground mb-2 text-xl font-bold">Zacznij od własnego klucza API</h2>
    <p class="text-muted-foreground mx-auto mb-5 max-w-lg text-sm leading-snug">
      TaskerLight działa w modelu BYOK (<span class="italic">bring your own key</span>): klasyfikację Twoich myśli
      wykonuje model AI uruchamiany na Twoim własnym kluczu {providerName} — bez pośredników i bez abonamentu.
    </p>

    <ul class="mx-auto mb-6 flex max-w-lg flex-col gap-3 text-left">
      <li class="flex items-start gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-done-fg mt-0.5 shrink-0"
        >
          <path
            d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
          ></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <p class="text-muted-foreground text-sm leading-snug">
          <span class="text-foreground font-medium">Klucz jest nie do wyciągnięcia.</span>
          Natychmiast po zapisaniu szyfrujemy go mocnym szyfrowaniem (AES-256-GCM) i przechowujemy wyłącznie zaszyfrowaną
          kopertę — nie da się go podejrzeć ani wyświetlić ponownie.
        </p>
      </li>
      <li class="flex items-start gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-done-fg mt-0.5 shrink-0"
        >
          <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"
          ></path>
          <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
          <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
          <path d="m2 2 20 20"></path>
        </svg>
        <p class="text-muted-foreground text-sm leading-snug">
          <span class="text-foreground font-medium">Nigdy nie trafia do logów.</span>
          Komunikaty błędów, dziennik zdarzeń ani telemetria nie zawierają nawet fragmentu klucza.
        </p>
      </li>
      <li class="flex items-start gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-muted-foreground mt-0.5 shrink-0"
        >
          <rect width="16" height="16" x="4" y="4" rx="2"></rect>
          <rect width="6" height="6" x="9" y="9" rx="1"></rect>
          <path d="M15 2v2"></path>
          <path d="M15 20v2"></path>
          <path d="M2 15h2"></path>
          <path d="M2 9h2"></path>
          <path d="M20 15h2"></path>
          <path d="M20 9h2"></path>
          <path d="M9 2v2"></path>
          <path d="M9 20v2"></path>
        </svg>
        <p class="text-muted-foreground text-sm leading-snug">
          <span class="text-foreground font-medium">Obsługujemy modele {providerName}.</span>
          Aktualnie skonfigurowany model klasyfikacji:
          <code class="bg-muted text-foreground rounded px-1.5 py-0.5 font-mono text-xs">{model}</code>.
        </p>
      </li>
    </ul>

    <div class="flex flex-col justify-center gap-3 sm:flex-row">
      <a
        href={keysUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="border-border text-foreground hover:bg-accent hover:text-accent-foreground inline-flex items-center justify-center rounded-md border px-5 py-2 text-sm font-medium transition-colors"
      >
        1. Wygeneruj klucz w {providerName} ↗
      </a>
      <a
        href="/profile"
        class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-md px-5 py-2 text-sm font-medium transition-colors"
      >
        2. Zapisz klucz w profilu
      </a>
    </div>
    <p class="text-muted-foreground mt-4 text-xs">
      Po zapisaniu klucza wróć tutaj — wkleisz pierwszy wsad i zobaczysz, jak zamienia się w uporządkowane wpisy.
    </p>
  </div>
</section>
