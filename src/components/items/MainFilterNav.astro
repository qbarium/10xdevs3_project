---
// Single-select nawigacja między trzema widokami listy (FR-008 filtr główny — podzbiór 3 z 5
// docelowych filtrów; Zakończone/Anulowane → S-04). Aktywny stan wyróżniony wg dokładnego
// dopasowania `Astro.url.pathname` (exact, nie startsWith — inaczej /items podświetlałoby się
// także na /items/active). Osadzona na trzech stronach widoków. Klasy warunkowe przez natywną
// dyrektywę `class:list` (wzorzec .astro, np. Banner.astro).

const pathname = Astro.url.pathname;

const links = [
  { href: "/items", label: "Elementy do akceptacji" },
  { href: "/items/active", label: "Aktywne" },
  { href: "/items/trash", label: "Kosz" },
];

const isActive = (href: string): boolean => pathname === href;
---

<nav class="flex flex-wrap gap-2" aria-label="Filtr główny listy">
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-current={isActive(link.href) ? "page" : undefined}
        class:list={[
          "rounded-full border px-3 py-1.5 text-sm font-medium transition",
          isActive(link.href)
            ? "border-purple-300/40 bg-purple-400/20 text-white"
            : "border-white/10 bg-white/5 text-white/70 hover:bg-white/10",
        ]}
      >
        {link.label}
      </a>
    ))
  }
</nav>
