---
// Baner trybu sesji (S-13 F4) na `/items?session=<id>`: identyfikuje sesję (źródło, data, status)
// i niesie akcję powrotu do dziennika. Wariant `meta === null` = „sesja niedostępna" (śmieciowy /
// nieistniejący / cudzy odnośnik — rozstrzygnięte serwerowo w items.astro): komunikat + akcje wyjścia,
// strona nie renderuje wtedy listy. Statyczny .astro — treść liczona serwerowo, zero interaktywności.

import { importSessionStatusLabel } from "@/lib/labels";
import type { SessionRowData } from "@/components/import-sessions/SessionRow";
import type { ImportSessionStatus } from "@/types";

interface Props {
  /** Metadane sesji (SSR z `getSessionMeta`) albo `null` → wariant „sesja niedostępna". */
  meta: SessionRowData | null;
}

const { meta } = Astro.props;

// Kolory badge'a statusu — lustro STATUS_BADGE z wiersza dziennika (drobna, świadoma kopia:
// wiersz przechodzi przekształcenie w kartę w F5; wspólne źródło wtedy).
const STATUS_BADGE: Record<ImportSessionStatus, string> = {
  processing: "border-amber-300/30 bg-amber-400/10 text-amber-100",
  completed_with_items: "border-emerald-300/30 bg-emerald-400/10 text-emerald-100",
  completed_no_items: "border-white/15 bg-white/10 text-white/70",
  failed: "border-red-300/30 bg-red-400/10 text-red-100",
};

const EXIT_LINK =
  "rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-sm font-medium text-white/80 transition hover:bg-white/10 hover:text-white";
---

{
  meta ? (
    <section
      aria-label="Kontekst sesji importu"
      class="flex flex-wrap items-center gap-3 rounded-xl border border-purple-300/25 bg-purple-400/10 px-4 py-3 backdrop-blur-xl"
    >
      <div class="min-w-0 flex-1">
        <p class="text-sm text-white/90">
          Wpisy dla sesji importu — <span class="font-medium text-purple-100">{meta.preview}</span>
          <span class="whitespace-nowrap text-white/60">, {meta.dateLabel}</span>
        </p>
      </div>
      <span
        class:list={[
          "rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap",
          STATUS_BADGE[meta.status],
        ]}
      >
        {importSessionStatusLabel(meta.status)}
      </span>
      <a href="/import-sessions" class:list={EXIT_LINK}>
        Wróć do dziennika
      </a>
    </section>
  ) : (
    <section
      role="alert"
      class="flex flex-col gap-3 rounded-xl border border-amber-300/30 bg-amber-400/10 px-4 py-4 backdrop-blur-xl"
    >
      <p class="text-sm text-amber-100">Sesja niedostępna — odnośnik jest nieprawidłowy albo sesja nie istnieje.</p>
      <div class="flex flex-wrap gap-2">
        <a href="/import-sessions" class:list={EXIT_LINK}>
          Wróć do dziennika
        </a>
        <a href="/items" class:list={EXIT_LINK}>
          Przejdź do listy wpisów
        </a>
      </div>
    </section>
  )
}
