---
// Ikony powłoki jako inline SVG (bez React/wyspy — sidebar jest statyczny). Ścieżki w stylu lucide,
// przeniesione z makiety (`context/foundation/ui-mockup/taskerlight-list.html`). `currentColor` →
// kolor dziedziczy po rodzicu (pozycja nav), więc aktywny stan steruje też ikoną. Renderowane jako
// realne elementy <path> (bez `set:html`); typ `icon` zawęża dozwolone ikony. Prop nazwany `icon`
// (nie `name`), by nie kolidować z zdeprecjonowanym globalnym `name` w wyrażeniach szablonu.
type IconName = "layers" | "tray" | "inbox" | "history" | "book" | "settings" | "log-out";

interface Props {
  icon: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}
const { icon, size = 18, strokeWidth = 1.7, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={[className]}
>
  {
    icon === "layers" && (
      <Fragment>
        <path d="m12 3 9 5-9 5-9-5 9-5Z" />
        <path d="m3 13 9 5 9-5" />
      </Fragment>
    )
  }
  {
    icon === "tray" && (
      <Fragment>
        <path d="M3 13h4l2 3h6l2-3h4" />
        <path d="M5 6h14l2 7v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-5L5 6Z" />
      </Fragment>
    )
  }
  {
    icon === "inbox" && (
      <Fragment>
        <path d="M4 13h4l1.5 2.5h5L16 13h4" />
        <path d="M5 5h14l1 8v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-5L5 5Z" />
      </Fragment>
    )
  }
  {
    icon === "history" && (
      <Fragment>
        <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
        <path d="M3 4v4h4" />
        <path d="M12 8v4l3 2" />
      </Fragment>
    )
  }
  {
    icon === "book" && (
      <Fragment>
        <path d="M5 4h11a2 2 0 0 1 2 2v14H7a2 2 0 0 1-2-2V4Z" />
        <path d="M5 4a2 2 0 0 0-2 2v12a2 2 0 0 1 2-2" />
      </Fragment>
    )
  }
  {
    icon === "settings" && (
      <Fragment>
        <circle cx="12" cy="12" r="3" />
        <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 4.6 15H4.5a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.2-2.9l-.1-.1A2 2 0 1 1 8.5 5.2l.1.1A1.7 1.7 0 0 0 11 4.6V4.5a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 2.9 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.7 1.7 0 0 0 21.4 11h.1a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.9 1Z" />
      </Fragment>
    )
  }
  {
    icon === "log-out" && (
      <Fragment>
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
        <path d="m16 17 5-5-5-5" />
        <path d="M21 12H9" />
      </Fragment>
    )
  }
</svg>
