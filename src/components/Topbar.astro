---
import { ThemeToggle } from "@/components/ThemeToggle";
import { parseTheme, THEME_COOKIE } from "@/lib/theme";

const { user } = Astro.locals;
// Motyw rozwiązany serwerowo (jak w Layout) → wyspa dostaje poprawny stan początkowy propem,
// bez odwróconego aria-label do czasu hydracji. (F2 z przeglądu fazy 1.)
const theme = parseTheme(Astro.cookies.get(THEME_COOKIE)?.value);
---

<div
  class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {
    user ? (
      <>
        <span class="text-blue-100/70">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/ingest" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Skrzynka wejściowa
          </a>
          <a href="/items" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Do akceptacji
          </a>
          <a href="/items/active" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Wpisy
          </a>
          <a href="/import-sessions" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sesje importu
          </a>
          <a href="/profile" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Profil
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              Wyloguj się
            </button>
          </form>
          <ThemeToggle client:load initialTheme={theme} />
        </div>
      </>
    ) : (
      <>
        <span class="text-blue-100/70">Niezalogowany</span>
        <div class="flex items-center gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Zaloguj się
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Zarejestruj się
          </a>
          <ThemeToggle client:load initialTheme={theme} />
        </div>
      </>
    )
  }
</div>
