---
// Baner bramkujący US-06: pokazywany, dopóki użytkownik nie skonfiguruje klucza API dostawcy.
// Dwa linki: zewnętrzny do generowania klucza u dostawcy (nowa karta) i wewnętrzny do profilu.
// Render warunkowy należy do strony wołającej (dashboard pokazuje baner tylko gdy `!configured`).
interface Props {
  keysUrl: string;
  providerName: string;
}

const { keysUrl, providerName } = Astro.props;
---

<div
  role="status"
  class="mx-auto w-full max-w-2xl rounded-xl border border-amber-300/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-50 backdrop-blur-xl"
>
  <p class="font-semibold">Skonfiguruj Klucz API {providerName} w ustawieniach</p>
  <p class="mt-1 text-amber-100/80">
    <a
      href={keysUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="font-medium text-amber-200 underline transition-colors hover:text-amber-100"
    >
      Wygeneruj klucz w {providerName}
    </a>, a następnie zapisz go w
    <a href="/profile" class="font-medium text-amber-200 underline transition-colors hover:text-amber-100">
      profilu
    </a>.
  </p>
</div>
