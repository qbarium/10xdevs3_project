---
import { CLASSIFIER_MODEL } from "astro:env/server";

import AppLayout from "@/layouts/AppLayout.astro";
import ByokOnboarding from "@/components/ingest/ByokOnboarding.astro";
import IngestForm from "@/components/ingest/IngestForm";
import { createClient } from "@/lib/supabase";
import { getKeyStatus } from "@/lib/services/profile-key";
import { AI_PROVIDER_KEYS_URL, AI_PROVIDER_NAME } from "@/lib/config/byok";
import type { ByokKeyStatus } from "@/types";

export const prerender = false;

const { user } = Astro.locals;

// Middleware chroni /ingest (PROTECTED_ROUTES) — `user` jest tu zawsze ustawiony. Status klucza
// liczymy serwerowo (klient z cookies usera → RLS), by zdecydować: bramka US-06 czy formularz.
let keyStatus: ByokKeyStatus = { configured: false, hint: null, updatedAt: null };
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  try {
    keyStatus = await getKeyStatus(supabase, user.id);
  } catch {
    // Przejściowy błąd odczytu DB → łagodna degradacja: pokaż bramkę (bezpieczniejszy default).
    keyStatus = { configured: false, hint: null, updatedAt: null };
  }
}
---

<AppLayout title="Skrzynka wejściowa" subtitle="Wklej surowy tekst — AI rozbije go na typowane wpisy">
  {
    keyStatus.configured ? (
      <IngestForm initialKeyStatus={keyStatus} client:load />
    ) : (
      <ByokOnboarding keysUrl={AI_PROVIDER_KEYS_URL} providerName={AI_PROVIDER_NAME} model={CLASSIFIER_MODEL} />
    )
  }
</AppLayout>
