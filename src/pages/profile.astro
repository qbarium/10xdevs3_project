---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ApiKeyManager from "@/components/profile/ApiKeyManager";
import { createClient } from "@/lib/supabase";
import { getKeyStatus } from "@/lib/services/profile-key";
import type { ByokKeyStatus } from "@/types";

export const prerender = false;

const { user } = Astro.locals;

// Middleware chroni /profile (PROTECTED_ROUTES) — `user` jest tu zawsze ustawiony. Wstępny status
// liczymy serwerowo (klient Supabase z cookies usera → RLS), by uniknąć migotania po hydracji islandu.
let initialStatus: ByokKeyStatus = { configured: false, hint: null, updatedAt: null };
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  try {
    initialStatus = await getKeyStatus(supabase, user.id);
  } catch {
    // Przejściowy błąd odczytu DB → łagodna degradacja: pokaż formularz zapisu.
    initialStatus = { configured: false, hint: null, updatedAt: null };
  }
}
---

<Layout title="Profil">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-6xl">
      <Topbar />
      <main class="mt-8">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Profil
        </h1>
        <ApiKeyManager initialStatus={initialStatus} client:load />
      </main>
    </div>
  </div>
</Layout>
