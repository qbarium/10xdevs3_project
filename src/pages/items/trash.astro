---
// Widok „Kosz" (S-06) — interaktywna wyspa zamiast read-only listy. Ładuje OBA statusy kosza
// (`rejected` + `deleted`) i montuje TrashItemsView: filtr typu, restore (per-item + bulk),
// „Wyczyść kosz". SSR, chroniony middleware (PROTECTED_ROUTES obejmuje prefiks /items); dane serwerowo
// (klient z cookies usera → RLS izoluje); przejściowy błąd → pusta lista (łagodna degradacja).
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import MainFilterNav from "@/components/items/MainFilterNav.astro";
import TrashItemsView from "@/components/items/TrashItemsView.tsx";
import { parseTypeFilter, TYPE_FILTER_COOKIE } from "@/components/items/type-filter";
import { createClient } from "@/lib/supabase";
import { getTrashItems } from "@/lib/services/items";
import type { Item } from "@/types";

export const prerender = false;

const { user } = Astro.locals;

let items: Item[] = [];
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  try {
    items = await getTrashItems(supabase, user.id);
  } catch {
    items = [];
  }
}

// Filtr typu z cookie (wspólny z widokami accepted) — SSR renderuje od razu poprawnie przefiltrowaną listę.
const initialTypeFilter = parseTypeFilter(Astro.cookies.get(TYPE_FILTER_COOKIE)?.value);
---

<Layout title="Kosz">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <main class="mt-8 flex flex-col gap-6">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Kosz
        </h1>
        <MainFilterNav />
        <TrashItemsView client:load initialItems={items} initialTypeFilter={initialTypeFilter} />
      </main>
    </div>
  </div>
</Layout>
