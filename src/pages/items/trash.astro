---
// Widok „Kosz" (S-06) — interaktywna wyspa zamiast read-only listy. Ładuje OBA statusy kosza
// (`rejected` + `deleted`) i montuje TrashItemsView: filtr typu, restore (per-item + bulk),
// „Wyczyść kosz". SSR, chroniony middleware (PROTECTED_ROUTES obejmuje prefiks /items); dane serwerowo
// (klient z cookies usera → RLS izoluje); przejściowy błąd → pusta lista (łagodna degradacja).
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import MainFilterNav from "@/components/items/MainFilterNav.astro";
import TrashItemsView from "@/components/items/TrashItemsView.tsx";
import { ITEMS_LIST_PAGE_SIZE_KEY, withPageSizePref } from "@/components/lists/page-size-pref";
import { createClient } from "@/lib/supabase";
import { listItems } from "@/lib/services/items";
import { ITEM_PAGE_SIZES, parseListCriteria } from "@/lib/services/list-criteria";
import type { Item } from "@/types";

export const prerender = false;

const { user } = Astro.locals;

// Kryteria listy z adresu strony (filtr typu/sort/szukanie) — ten sam parser co klient → render SSR
// i pierwszy stan wyspy są identyczne (hydration-stable, bez przeskoku). `view` na sztywno per strona.
// Preferencja rozmiaru strony z COOKIE nakładana już przy SSR (URL z `size` ma pierwszeństwo).
const criteria = withPageSizePref(
  parseListCriteria("trash", Astro.url.searchParams),
  Astro.url.searchParams,
  Astro.cookies.get(ITEMS_LIST_PAGE_SIZE_KEY)?.value,
  ITEM_PAGE_SIZES,
);

let items: Item[] = [];
let total = 0;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  try {
    ({ items, total } = await listItems(supabase, user.id, criteria, { page: criteria.page, size: criteria.size }));
  } catch {
    items = [];
    total = 0;
  }
}
---

<Layout title="Kosz">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-6xl">
      <Topbar />
      <main class="mt-8 flex flex-col gap-6">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Kosz
        </h1>
        <MainFilterNav />
        <TrashItemsView client:load initialItems={items} initialCriteria={criteria} initialTotal={total} />
      </main>
    </div>
  </div>
</Layout>
