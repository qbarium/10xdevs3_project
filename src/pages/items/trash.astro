---
// Widok „Kosz" — read-only lista odrzuconych itemów (S-03). Przenieś-do-kosza/przywróć/wyczyść
// (FR-013/FR-016) to S-06 — tu Kosz pokazuje wyłącznie `rejected`, bez akcji. SSR, chroniony
// middleware; dane serwerowo (RLS); przejściowy błąd → pusta lista (wzorzec items.astro).
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import MainFilterNav from "@/components/items/MainFilterNav.astro";
import ItemList from "@/components/items/ItemList.astro";
import { createClient } from "@/lib/supabase";
import { getRejectedItems } from "@/lib/services/items";
import type { Item } from "@/types";

export const prerender = false;

const { user } = Astro.locals;

let items: Item[] = [];
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  try {
    items = await getRejectedItems(supabase, user.id);
  } catch {
    items = [];
  }
}
---

<Layout title="Kosz">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <main class="mt-8 flex flex-col gap-6">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Kosz
        </h1>
        <MainFilterNav />
        <ItemList items={items} emptyLabel="Kosz jest pusty." />
      </main>
    </div>
  </div>
</Layout>
