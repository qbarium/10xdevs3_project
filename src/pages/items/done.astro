---
// Widok „Zakończone" — read-only lista zaakceptowanych itemów ze stanem operacyjnym `done` (S-04).
// SSR, chroniony middleware (PROTECTED_ROUTES obejmuje prefiks /items). Dane serwerowo (klient
// z cookies usera → RLS izoluje); przejściowy błąd → pusta lista (łagodna degradacja, wzorzec
// items.astro). Interaktywność (badge-menu + bulk) dochodzi w Fazie 4 — tu read-only z badge per-typ.
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import MainFilterNav from "@/components/items/MainFilterNav.astro";
import AcceptedItemsView from "@/components/items/AcceptedItemsView.tsx";
import { createClient } from "@/lib/supabase";
import { listItems } from "@/lib/services/items";
import { parseListCriteria } from "@/lib/services/list-criteria";
import type { Item } from "@/types";

export const prerender = false;

const { user } = Astro.locals;

// Kryteria listy z adresu strony (filtr typu/sort/szukanie) — ten sam parser co klient → render SSR
// i pierwszy stan wyspy są identyczne (hydration-stable, bez przeskoku). `view` na sztywno per strona.
const criteria = parseListCriteria("done", Astro.url.searchParams);

let items: Item[] = [];
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  try {
    items = await listItems(supabase, user.id, criteria);
  } catch {
    items = [];
  }
}
---

<Layout title="Zakończone">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <main class="mt-8 flex flex-col gap-6">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Zakończone
        </h1>
        <MainFilterNav />
        <AcceptedItemsView client:load initialItems={items} view="done" initialCriteria={criteria} canAdd={false} />
      </main>
    </div>
  </div>
</Layout>
