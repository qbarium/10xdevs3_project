---
// Widok „Zakończone" — read-only lista zaakceptowanych itemów ze stanem operacyjnym `done` (S-04).
// SSR, chroniony middleware (PROTECTED_ROUTES obejmuje prefiks /items). Dane serwerowo (klient
// z cookies usera → RLS izoluje); przejściowy błąd → pusta lista (łagodna degradacja, wzorzec
// items.astro). Interaktywność (badge-menu + bulk) dochodzi w Fazie 4 — tu read-only z badge per-typ.
import AppLayout from "@/layouts/AppLayout.astro";
import AcceptedItemsView from "@/components/items/AcceptedItemsView.tsx";
import TopbarItemAction from "@/components/items/TopbarItemAction.tsx";
import TopbarItemSearch from "@/components/items/TopbarItemSearch.tsx";
import { ITEMS_LIST_PAGE_SIZE_KEY, withPageSizePref } from "@/components/lists/page-size-pref";
import { createClient } from "@/lib/supabase";
import { listItems } from "@/lib/services/items";
import { ITEM_PAGE_SIZES, parseListCriteria } from "@/lib/services/list-criteria";
import type { Item } from "@/types";

export const prerender = false;

const { user } = Astro.locals;

// Kryteria listy z adresu strony (filtr typu/sort/szukanie) — ten sam parser co klient → render SSR
// i pierwszy stan wyspy są identyczne (hydration-stable, bez przeskoku). `view` na sztywno per strona.
// Preferencja rozmiaru strony z COOKIE nakładana już przy SSR (URL z `size` ma pierwszeństwo).
const criteria = withPageSizePref(
  parseListCriteria("done", Astro.url.searchParams),
  Astro.url.searchParams,
  Astro.cookies.get(ITEMS_LIST_PAGE_SIZE_KEY)?.value,
  ITEM_PAGE_SIZES,
);

let items: Item[] = [];
let total = 0;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  try {
    ({ items, total } = await listItems(supabase, user.id, criteria, { page: criteria.page, size: criteria.size }));
  } catch {
    items = [];
    total = 0;
  }
}
---

<AppLayout title="Wpisy" subtitle="Wpisy z zamkniętą realizacją" fill>
  <TopbarItemSearch slot="search" client:load initialQuery={criteria.q} />
  <TopbarItemAction slot="actions" client:load action="add" />
  <AcceptedItemsView
    client:load
    initialItems={items}
    view="done"
    initialCriteria={criteria}
    initialTotal={total}
    canAdd
  />
</AppLayout>
