---
// Widok „Zakończone" — read-only lista zaakceptowanych itemów ze stanem operacyjnym `done` (S-04).
// SSR, chroniony middleware (PROTECTED_ROUTES obejmuje prefiks /items). Dane serwerowo (klient
// z cookies usera → RLS izoluje); przejściowy błąd → pusta lista (łagodna degradacja, wzorzec
// items.astro). Interaktywność (badge-menu + bulk) dochodzi w Fazie 4 — tu read-only z badge per-typ.
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import MainFilterNav from "@/components/items/MainFilterNav.astro";
import AcceptedItemsView from "@/components/items/AcceptedItemsView.tsx";
import { parseTypeFilter, TYPE_FILTER_COOKIE } from "@/components/items/type-filter";
import { createClient } from "@/lib/supabase";
import { getDoneItems } from "@/lib/services/items";
import type { Item } from "@/types";

export const prerender = false;

const { user } = Astro.locals;

let items: Item[] = [];
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  try {
    items = await getDoneItems(supabase, user.id);
  } catch {
    items = [];
  }
}

// Filtr typu z cookie (per widok) — SSR renderuje od razu poprawnie przefiltrowaną listę (bez przeskoku).
const initialTypeFilter = parseTypeFilter(Astro.cookies.get(TYPE_FILTER_COOKIE)?.value);
---

<Layout title="Zakończone">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <main class="mt-8 flex flex-col gap-6">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Zakończone
        </h1>
        <MainFilterNav />
        <AcceptedItemsView client:load initialItems={items} view="done" initialTypeFilter={initialTypeFilter} />
      </main>
    </div>
  </div>
</Layout>
