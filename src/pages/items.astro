---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import PendingItemsList from "@/components/items/PendingItemsList.astro";
import { createClient } from "@/lib/supabase";
import { getPendingItems } from "@/lib/services/items";
import type { Item } from "@/types";

export const prerender = false;

const { user } = Astro.locals;

// Middleware chroni /items (PROTECTED_ROUTES) — `user` zawsze ustawiony. Pendingi liczymy serwerowo
// (klient z cookies usera → RLS izoluje). To cel auto-przejścia z modalu klasyfikacji (Faza 4).
let items: Item[] = [];
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  try {
    items = await getPendingItems(supabase, user.id);
  } catch {
    // Przejściowy błąd odczytu → pusta lista (łagodna degradacja).
    items = [];
  }
}
---

<Layout title="Elementy do akceptacji">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <Topbar />
      <main class="mt-8 flex flex-col gap-6">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Elementy do akceptacji
        </h1>
        <PendingItemsList items={items} />
      </main>
    </div>
  </div>
</Layout>
