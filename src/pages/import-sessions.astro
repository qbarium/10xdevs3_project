---
import AppLayout from "@/layouts/AppLayout.astro";
import ImportSessionsView from "@/components/import-sessions/ImportSessionsView";
import type { SessionRowData } from "@/components/import-sessions/SessionCard";
import { SESSION_LOG_PAGE_SIZE_KEY, withPageSizePref } from "@/components/lists/page-size-pref";
import { createClient } from "@/lib/supabase";
import { getImportSessions, reapStaleProcessing, toSessionRow } from "@/lib/services/import-session";
import { parseSessionListCriteria, SESSION_PAGE_SIZES } from "@/lib/services/session-list-criteria";

export const prerender = false;

const { user } = Astro.locals;

// S-11: kryteria dziennika (status/sort/page) z adresu strony przez TEN SAM tolerancyjny parser, co endpoint
// i hook — render serwerowy i pierwszy stan wyspy są identyczne (hydration-stable, brak przeskoku po hydracji).
// Preferencja rozmiaru strony z COOKIE nakładana już przy SSR (URL z `size` ma pierwszeństwo) — serwer
// renderuje od razu właściwą liczbę wierszy, kliencka adopcja jest no-opem (bez migotania listy).
const criteria = withPageSizePref(
  parseSessionListCriteria(Astro.url.searchParams),
  Astro.url.searchParams,
  Astro.cookies.get(SESSION_LOG_PAGE_SIZE_KEY)?.value,
  SESSION_PAGE_SIZES,
);

// Middleware chroni /import-sessions (PROTECTED_ROUTES) — `user` zawsze ustawiony. Pierwsza strona listy
// serwerowo (klient z cookies usera → RLS izoluje per-user). Przejściowy błąd odczytu → pusta strona
// (degradacja). Stan początkowy (wiersze + total) trafia do wyspy, która dalej steruje listą reaktywnie
// (hook useSessionList) — bez przycisku „Zastosuj" i bez przeładowania strony.
let initialRows: SessionRowData[] = [];
let initialTotal = 0;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  // Reaper best-effort: nieświeże `processing` (ubite bez terminalnego update'u, np. limit CPU Workers)
  // → `failed`, by istniejący retry je odzyskał. Własny try/catch — awaria reapa NIE może zablankować dziennika.
  try {
    await reapStaleProcessing(supabase, user.id);
  } catch {
    // best-effort: świadomie połykamy — dziennik ma się wyrenderować niezależnie od reapa
  }
  try {
    const { sessions, total } = await getImportSessions(supabase, user.id, {
      sort: criteria.sort,
      status: criteria.status === "all" ? undefined : criteria.status,
      page: criteria.page,
      pageSize: criteria.size,
    });
    initialRows = sessions.map(toSessionRow);
    initialTotal = total;
  } catch {
    initialRows = [];
    initialTotal = 0;
  }
}
---

<AppLayout title="Sesje importu" subtitle="Historia wsadów — status klasyfikacji i ponawianie">
  <ImportSessionsView client:load initialRows={initialRows} initialCriteria={criteria} initialTotal={initialTotal} />
</AppLayout>
