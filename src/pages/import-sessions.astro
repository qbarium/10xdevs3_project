---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import ImportSessionsView from "@/components/import-sessions/ImportSessionsView";
import type { SessionRowData } from "@/components/import-sessions/SessionCard";
import { createClient } from "@/lib/supabase";
import { getImportSessions, toSessionRow } from "@/lib/services/import-session";
import { parseSessionListCriteria } from "@/lib/services/session-list-criteria";

export const prerender = false;

const { user } = Astro.locals;

// S-11: kryteria dziennika (status/sort/page) z adresu strony przez TEN SAM tolerancyjny parser, co endpoint
// i hook — render serwerowy i pierwszy stan wyspy są identyczne (hydration-stable, brak przeskoku po hydracji).
const criteria = parseSessionListCriteria(Astro.url.searchParams);

// Middleware chroni /import-sessions (PROTECTED_ROUTES) — `user` zawsze ustawiony. Pierwsza strona listy
// serwerowo (klient z cookies usera → RLS izoluje per-user). Przejściowy błąd odczytu → pusta strona
// (degradacja). Stan początkowy (wiersze + total) trafia do wyspy, która dalej steruje listą reaktywnie
// (hook useSessionList) — bez przycisku „Zastosuj" i bez przeładowania strony.
let initialRows: SessionRowData[] = [];
let initialTotal = 0;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (user && supabase) {
  try {
    const { sessions, total } = await getImportSessions(supabase, user.id, {
      sort: criteria.sort,
      status: criteria.status === "all" ? undefined : criteria.status,
      page: criteria.page,
      pageSize: criteria.size,
    });
    initialRows = sessions.map(toSessionRow);
    initialTotal = total;
  } catch {
    initialRows = [];
    initialTotal = 0;
  }
}
---

<Layout title="Sesje importu">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-6xl">
      <Topbar />
      <main class="mt-8 flex flex-col gap-6">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Sesje importu
        </h1>

        <ImportSessionsView
          client:load
          initialRows={initialRows}
          initialCriteria={criteria}
          initialTotal={initialTotal}
        />
      </main>
    </div>
  </div>
</Layout>
